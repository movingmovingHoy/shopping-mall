<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.shop.product.mapper.ProductMapper">

    <!-- status는 enum이지만 MyBatis가 name()("ON_SALE")으로 바꿔서 넣어 준다. created_at은 DB 기본값 사용 -->
    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product (category_id, name, price, stock_quantity, status, description)
        VALUES (#{categoryId}, #{name}, #{price}, #{stockQuantity}, #{status}, #{description})
    </insert>

    <!-- category_id → categoryId, stock_quantity → stockQuantity 는 map-underscore-to-camel-case로 자동 매핑 -->
    <select id="findById" resultType="com.example.shop.product.domain.Product">
        SELECT id, category_id, name, price, stock_quantity, status, description, created_at
        FROM product
        WHERE id = #{id}
    </select>

    <!--
        MyBatis는 JPA처럼 객체 값이 바뀌었다고 자동으로 UPDATE해 주지 않는다(변경 감지 없음).
        product.stop()으로 객체만 바꾸면 DB는 그대로이므로, 이 UPDATE를 직접 호출해야 한다.
        status 컬럼만 바꾸는 쿼리라 다른 컬럼(가격, 재고 등)은 건드리지 않는다.
    -->
    <update id="updateStatus">
        UPDATE product
        SET status = #{status}
        WHERE id = #{id}
    </update>

    <!--
        목록 조회와 개수 조회가 같은 WHERE 조건을 써야 한다.
        두 곳에 따로 쓰면 한쪽만 고쳤을 때 "목록은 3개인데 totalCount는 5" 같은 불일치가 생기므로
        <sql>로 한 번만 정의하고 <include>로 가져다 쓴다.

        <if test="categoryId != null">: categoryId가 null이면 AND 줄이 SQL에서 통째로 빠진다. (동적 SQL)
          categoryId=1  → WHERE status = 'ON_SALE' AND category_id = ?
          categoryId 없음 → WHERE status = 'ON_SALE'
        'ON_SALE'은 사용자 입력이 아니라 고정된 문자열이라 SQL에 그대로 써도 안전하다.
    -->
    <sql id="onSaleCondition">
        WHERE status = 'ON_SALE'
        <if test="categoryId != null">
            AND category_id = #{categoryId}
        </if>
    </sql>

    <!--
        ORDER BY가 필요한 이유: 정렬 없이 LIMIT/OFFSET을 쓰면 DB가 순서를 보장하지 않아서
        1페이지에 나온 상품이 2페이지에 또 나오거나 빠질 수 있다.
        id DESC: id는 AUTO_INCREMENT라 클수록 나중에 등록된 상품 = 최신순.
    -->
    <select id="findAll" resultType="com.example.shop.product.domain.Product">
        SELECT id, category_id, name, price, stock_quantity, status, description, created_at
        FROM product
        <include refid="onSaleCondition"/>
        ORDER BY id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*)
        FROM product
        <include refid="onSaleCondition"/>
    </select>

</mapper>
